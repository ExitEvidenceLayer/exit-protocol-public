    "/v0/research/solana/mint": {
      "get": {
        "summary": "Any Solana token mint: mint/freeze/supported Token-2022 authorities and holder accounts (one finalized read, at most three read-only RPC calls). Response headers: X-EXIT-Research-State (ANSWERED / NEEDS_RESEARCH / ...), X-EXIT-Replayed.",
        "security": [
          {
            "bearer": []
          }
        ],
        "parameters": [
          {
            "name": "mint",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[1-9A-HJ-NP-Za-km-z]{32,44}$"
            }
          },
          {
            "name": "X-EXIT-Request-Id",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[!-~]{1,64}$"
            },
            "description": "Printable ASCII, 1\u201364 characters. On research queries, the same account/id/query replays a stored response when available. Explicit record/watch checks also enforce lifecycle and cadence guards; a repeat can be refused as not due."
          }
        ],
        "responses": {
          "200": {
            "description": "exit.solana-mint-research/1",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "4XX": {
            "description": "Refused: JSON {error}. 0 credits.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "5XX": {
            "description": "Service or provider failure: JSON {error}. 0 credits.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/v0/control_state": {
      "get": {
        "summary": "Recorded subject: who controls it in the recorded view. Response headers: X-EXIT-Research-State (ANSWERED / NEEDS_RESEARCH / ...), X-EXIT-Replayed.",
        "security": [
          {
            "bearer": []
          }
        ],
        "parameters": [
          {
            "name": "subject_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "usdc-mint-authorities",
                "pyusd-mint-authorities",
                "pump-fun-program-upgrade-authority"
              ]
            }
          },
          {
            "name": "valid_at",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date-time"
            },
            "description": "the time asked about (ISO-8601 with timezone)"
          },
          {
            "name": "known_at",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date-time"
            },
            "description": "only evidence known by then is used (ISO-8601 with timezone)"
          },
          {
            "name": "X-EXIT-Request-Id",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[!-~]{1,64}$"
