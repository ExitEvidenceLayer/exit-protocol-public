{
  "openapi": "3.1.0",
  "info": {
    "title": "EXIT free research API (early access)",
    "version": "2026-10-26",
    "description": "Evidence-bound answers about who can control a token: sources, event time and knowledge time, and limits are kept. Free early access (30 days): no payment, no wallet. Get a key in a browser at https://api.exit-protocol.io; keep it private. Daily limits per key apply; unsupported or unresolved questions are never presented as completed answers. Not a safety verdict, price prediction or identification of people."
  },
  "servers": [
    {
      "url": "https://api.exit-protocol.io"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "exit_free_ + 43 characters"
      }
    }
  },
