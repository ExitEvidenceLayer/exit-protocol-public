    "/v0/research/ethereum/contract": {
      "get": {
        "summary": "Any Ethereum contract: proxy implementation/admin slots, the owner() getter as an observation and whether each named address holds code, at one finalized block (at most eleven read-only calls). Provider failures are recorded as research records (X-EXIT-Research-Record).",
        "security": [
          {
            "bearer": []
          }
        ],
        "parameters": [
          {
            "name": "address",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^0x[0-9a-fA-F]{40}$"
            }
          },
          {
            "name": "X-EXIT-Request-Id",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[!-~]{1,64}$"
            },
            "description": "Printable ASCII, 1\u201364 characters. On research queries, the same account/id/query replays a stored response when available. Explicit record/watch checks also enforce lifecycle and cadence guards; a repeat can be refused as not due."
          }
        ],
        "responses": {
          "200": {
            "description": "exit.ethereum-contract-research/1",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "4XX": {
            "description": "Refused: JSON {error}. 0 credits.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "5XX": {
            "description": "Service or provider failure: JSON {error}. 0 credits. May carry X-EXIT-Research-Record / -State / -Gap.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
